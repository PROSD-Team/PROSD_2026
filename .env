COMPOSE_PROJECT_NAME=prosd-system

ENVIRONMENT=development
ENABLE_OBSERVABILITY=true

ENABLE_METRICS=true
ENABLE_LOGGING=true

POSTGRES_USER=prosd_user
POSTGRES_PASSWORD=ChangeMe123!
POSTGRES_DB=prosd_db
DB_HOST=postgres
DB_PORT=5432

RABBITMQ_DEFAULT_USER=prosd
RABBITMQ_DEFAULT_PASS=ChangeMe456!
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

RABBITMQ_QUEUE=prosd-jobs
RABBITMQ_MAX_RETRIES=3
RABBITMQ_DLQ_EXCHANGE=prosd-dlq
RABBITMQ_DLQ_QUEUE=prosd-dlq-queue

MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=ChangeMe789!
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=prosd-files

BACKEND_PORT=5000
FRONTEND_PORT=3000
PYTHON_METRICS_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100

GRAFANA_ADMIN_PASSWORD=admin123
VITE_API_URL=http://localhost:5000